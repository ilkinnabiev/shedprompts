{
  "name": "shedprompts",
  "version": "0.1.0",
  "description": "Schedule one-shot prompts for local coding agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilkinnabiev/shedprompts.git"
  },
  "bugs": "https://github.com/ilkinnabiev/shedprompts/issues",
  "type": "module",
  "bin": {
    "shed": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "ui",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
